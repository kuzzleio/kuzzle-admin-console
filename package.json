    "test:lint": "eslint src test/e2e/cypress",
    "test:lint:fix": "eslint src test/e2e/cypress --fix",
    "test:types": "vue-tsc --noEmit -p tsconfig.test.json",
    "check:unreachable": "node scripts/unreachable-modules.ts",
    "check:listener-collisions": "node scripts/listener-name-collisions.ts",
    "check:dom-emits": "node scripts/undeclared-dom-emits.ts",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/ubuntu": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@vue-leaflet/vue-leaflet": "0.10.1",
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "ace-builds": "1.39.1",
    "apexcharts": "3.53.0",
    "bluebird": "3.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "json-formatter-js": "2.5.23",
    "kepler-companion": "1.1.6",
    "kuzzle-sdk-v6": "npm:kuzzle-sdk@6.2.8",
    "kuzzle-sdk-v7": "npm:kuzzle-sdk@^7.15.0",
    "leaflet": "1.9.4",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "pinia": "3.0.4",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.43",
    "vue-draggable-plus": "0.6.1",
    "vue-multiselect": "3.5.0",
    "vue-router": "4.6.4",
    "vue3-apexcharts": "1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9.17",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "cypress": "16.1.0",
    "cypress-wait-until": "3.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-vue-kuzzle": "2.0.0",
    "file-loader": "6.2.0",
    "globals": "17.12.0",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "7.1.1",
