{
  "name": "kuzzle-admin-console",
  "version": "4.4.0",
  "description": "A handy administrative console for Kuzzle",
  "author": "The Kuzzle team <support@kuzzle.io>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:e2e",
