    "ts-mock-imports": "1.3.16",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 11.0.0"
  },
  "keywords": [
    "kuzzle",
    "backoffice",
    "console",
    "admin",
    "admin console"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/kuzzleio/kuzzle-admin-console.git"
